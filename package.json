{
  "name": "@joe0001/dsh-prompt-optimizer",
  "version": "0.2.1",
  "description": "Improve the current chat draft before sending: one click optimizes the draft with the session's current model and shows an original-vs-result comparison before you decide to adopt. 一键用当前模型优化聊天输入，采用前先对比原文与优化结果。",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LHF198/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/LHF198/dsh-prompt-optimizer",
  "bugs": {
    "url": "https://github.com/LHF198/dsh-prompt-optimizer/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/adr/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "prompt",
    "optimize",
    "prompt-optimizer",
    "ui"
  ],
  "scripts": {
    "lint": "node --check lib/index.js && node --check lib/client.js",
    "build": "node --check lib/index.js && node --check lib/client.js && node -e \"if(!require('fs').existsSync('lib/client.js'))process.exit(1)\"",
    "test": "node test/verify.js && node --test test/abort.test.js"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
